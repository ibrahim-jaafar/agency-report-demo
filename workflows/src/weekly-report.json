    {
      "id": "7f59870e-31af-9f82-902e-c151ec7d220c",
      "name": "Meta requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        -300
      ],
      "parameters": {
        "jsCode": "const { clients } = $('CRM data').first().json;\nconst body = data => ({ data, test_event_code: 'TEST68789' });\nconst reqs = [];\nfor (const c of Object.values(clients)) {\n  // ponytail: always one request per client, even with no events (Meta then answers 400; counted as 0 sent)\n  reqs.push({ client: c.client, kind: 'main', count: c.events.length, req: { method: 'POST', url: 'https://graph.facebook.com/v23.0/2897515730634456/events', body: body(c.events) } });\n  // the deliberately too-old event goes alone, so Meta's rejection can't sink the real batch\n  if (c.edgeEvents.length) reqs.push({ client: c.client, kind: 'edge', count: c.edgeEvents.length, req: { method: 'POST', url: 'https://graph.facebook.com/v23.0/2897515730634456/events', body: body(c.edgeEvents) } });\n}\nreturn reqs.map(json => ({ json }));"
      }
    },
