      "parameters": {
        "operation": "executeQuery",
        "query": "-- show the visitor the CRM step is done\nwith u as (update demo_runs set steps = $2::jsonb where id = $1::uuid)\nselect 1 as saved",
        "options": {
          "queryReplacement": "={{ [$json.runId, JSON.stringify($json.steps)] }}"
        }
