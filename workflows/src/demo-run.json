      "parameters": {
        "operation": "executeQuery",
        "query": "select coalesce(json_agg(json_build_object('id', id, 'status', status, 'created_at', created_at)), '[]'::json) as runs\nfrom demo_runs where created_at >= now() - interval '1 day'",
        "options": {}
      },
