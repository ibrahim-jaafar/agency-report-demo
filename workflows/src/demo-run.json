      "typeVersion": 2.5,
      "position": [
        880,
        120
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select (select report from demo_runs where status in ('done','partial') order by created_at desc limit 1) as latest",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "8VYMdYQi4ONq8evJ",
