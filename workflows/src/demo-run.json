      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        880,
        -120
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into demo_runs (status, scenario, steps) values ('running', $1::jsonb, $2::jsonb) returning id",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json.scenario), JSON.stringify($json.steps)] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "8VYMdYQi4ONq8evJ",
          "name": "Supabase demo"
        }
      }
    },
