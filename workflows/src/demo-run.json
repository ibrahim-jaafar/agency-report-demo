      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "/*@lib*/\nlet body = $('Start webhook').first().json.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch { body = null; } }\nconst scenario = parseScenario(body);\nconst limit = checkLimits($input.first().json.runs || [], new Date());\nconst steps = ['ghl', 'spend', 'meta', 'checks', 'ai'].map(key => ({ key, status: 'pending' }));\nreturn [{ json: { scenario, limit, steps } }];"
      }
    },
    {
      "id": "f5cb742f-490f-436f-95a5-e2648c5dd451",
      "name": "Allowed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "84dd3241-5364-4c82-a0f6-fac1ef309e3c",
              "leftValue": "={{ $json.limit.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "5833ceb0-bc2f-4e08-91c5-5210d670629e",
