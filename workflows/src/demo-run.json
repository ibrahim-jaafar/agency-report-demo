      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "update demo_runs set status = $2, report = $3::jsonb where id = $1::uuid",
        "options": {
          "queryReplacement": "={{ [$('Create run').first().json.id, 'done', 'null'] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "8VYMdYQi4ONq8evJ",
          "name": "Supabase demo"
        }
      }
    },
    {
      "id": "7b89a036-b953-40db-b944-4eb1f4f1017b",
      "name": "Latest report",
