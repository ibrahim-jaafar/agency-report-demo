    {
      "id": "53e8db8b-5f87-11fe-fe23-c1094fdad7f8",
      "name": "After GoHighLevel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "jsCode": "/*@lib*/\nconst t = $('Plan test lead').first().json, label = t.client === 'clinic' ? 'Clinic' : 'Store';\nconst deal = $(`${label}: test deal`).first().json, dealReply = $input.first().json;\nconst saved = !!deal.contactId, dealOk = t.lead.outcome === 'open' || dealReply.statusCode < 300;\nif (!saved) return [{ json: { ...t, saved, dealOk, meta: null } }];\n// a booking or order goes to Meta, like the run's\nconst crypto = require('crypto');\nconst sha256 = s => crypto.createHash('sha256').update(s).digest('hex');\nconst ev = buildMetaEvents(t.client, [t.lead], [], Math.floor(Date.now() / 1000), sha256).events;\nconst meta = ev.length ? { method: 'POST', url: 'https://graph.facebook.com/v23.0/2897515730634456/events', body: { data: ev, test_event_code: 'TEST68789' } } : null;\nreturn [{ json: { ...t, saved, dealOk, meta, req: meta } }];"
      }
    },
