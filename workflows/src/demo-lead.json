      "parameters": {
        "jsCode": "// Lumière Skin Clinic: a deal when the test lead booked, ordered, cancelled or was refunded\nconst t = $('Plan test lead').first().json, r = $input.first().json;\nconst contactId = r.statusCode < 300 ? r.body?.contact?.id : null;\nconst G = 'https://services.leadconnectorhq.com';\nif (contactId && t.lead.outcome !== 'open') return [{ json: { contactId, req: { method: 'POST', url: `${G}/opportunities/`, body: {\n  locationId: 'lX1GDRcqD985tKgOM4I3', pipelineId: 'e3YMhd6OJWtcGA9MFPnx', pipelineStageId: '8530b169-8cdc-4a71-bfc7-165e969395a6', contactId,\n  name: `${t.lead.firstName} ${t.lead.lastName} – consultation`, status: t.lead.outcome === 'converted' ? 'won' : 'lost', monetaryValue: t.lead.value } } } }];\n// ponytail: one harmless lookup when there's no deal to save (n8n stops a branch with no items)\nreturn [{ json: { contactId, req: { method: 'POST', url: `${G}/contacts/search`, body: { locationId: 'lX1GDRcqD985tKgOM4I3', pageLimit: 1 } } } }];"
      }
