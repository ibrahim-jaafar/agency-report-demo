# Render web service: image docker.io/n8nio/n8n:2.43.8, Free plan, region Frankfurt.
# Paste these as environment variables. <SECRET> values come from the password manager,
# typed into Render by Ibrahim only. Never commit real values.
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_PROXY_HOPS=1
N8N_WEBHOOK_URL=https://agency-report-demo.onrender.com/
# The free 0.1 CPU starts the Code-node runner slowly; the default 30 s grant times out.
N8N_RUNNERS_GRANT_TOKEN_TTL=120
GENERIC_TIMEZONE=UTC
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=<Supabase session pooler host, e.g. aws-0-<region>.pooler.supabase.com>
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres.<Supabase project ref>
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false
DB_POSTGRESDB_PASSWORD=<SECRET: Supabase database password>
N8N_ENCRYPTION_KEY=<SECRET: 32+ random characters, also kept in the password manager>
